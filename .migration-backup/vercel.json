{
  "version": 2,
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "artifacts/balebeleq-web/dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}
